<Project>
  <PropertyGroup>
    <LuminaUIDiagnosticsVersion>0.3.0</LuminaUIDiagnosticsVersion>
    <LuminaUIDiagnosticsAssemblyVersion>0.3.0.0</LuminaUIDiagnosticsAssemblyVersion>

    <Version>$(LuminaUIDiagnosticsVersion)</Version>
    <PackageVersion>$(LuminaUIDiagnosticsVersion)</PackageVersion>
    <AssemblyVersion>$(LuminaUIDiagnosticsAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(LuminaUIDiagnosticsAssemblyVersion)</FileVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <Authors>LuminaUI Contributors</Authors>
    <Company>LuminaUI</Company>
    <Product>LuminaUI.Diagnostics</Product>
    <PackageTags>Avalonia;UI;Diagnostics;MCP;LuminaUI</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
