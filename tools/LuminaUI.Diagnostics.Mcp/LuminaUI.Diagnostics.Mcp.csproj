<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lumina-mcp</ToolCommandName>
    <PackageId>LuminaUI.Diagnostics.Mcp</PackageId>
    <Version>$(LuminaUIDiagnosticsVersion)</Version>
    <PackageVersion>$(LuminaUIDiagnosticsVersion)</PackageVersion>
    <AssemblyVersion>$(LuminaUIDiagnosticsAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(LuminaUIDiagnosticsAssemblyVersion)</FileVersion>
    <InformationalVersion>$(LuminaUIDiagnosticsVersion)</InformationalVersion>
    <Description>MCP stdio server bridge for LuminaUI diagnostics hosts (compatibility tool package).</Description>
    <PackageTags>Avalonia;UI;Diagnostics;MCP;LuminaUI;dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LuminaUI.Diagnostics.Tool\LuminaUI.Diagnostics.Tool.csproj" />
  </ItemGroup>

</Project>
